# Copy this file to .env for the school's Oracle database.
# Fill in the username and password locally. Never commit .env.
TASKBUDDY_DB=oracle
TASKBUDDY_DB_HOST=10.110.10.90
TASKBUDDY_DB_PORT=1521
TASKBUDDY_DB_SID=oracle
TASKBUDDY_DB_USERNAME=
TASKBUDDY_DB_PASSWORD=

TASKBUDDY_API_HOST=127.0.0.1
TASKBUDDY_API_PORT=8000
TASKBUDDY_API_URL=http://127.0.0.1:8000
TASKBUDDY_SESSION_HOURS=12

# Only used when TASKBUDDY_DB=sqlite or when running run_demo.py.
TASKBUDDY_SQLITE_PATH=data/taskbuddy-demo.db
